# Copy to .env for local configuration. Never commit real keys.
DMSA_HTTP_BIND=127.0.0.1
DMSA_HTTP_PORT=8000
DMSA_MEMORY_API_KEY=replace-with-a-long-random-service-key
# Required explicitly for competition; no implicit provider or model.
DMSA_EMBEDDING_BASE_URL=
DMSA_EMBEDDING_API_KEY=
DMSA_EMBEDDING_MODEL=
DMSA_EMBEDDING_DIMENSION=1536
