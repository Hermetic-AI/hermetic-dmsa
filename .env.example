# Copy this file to .env, then add your provider keys. Never commit .env.
DMSA_HTTP_BIND=127.0.0.1
DMSA_HTTP_PORT=8000
DMSA_BROWSER_BIND=127.0.0.1
DMSA_BROWSER_PORT=8765
# Generate a strong secret, e.g. `openssl rand -hex 32`. Never reuse the example value.
DMSA_MEMORY_API_KEY=replace-with-a-long-random-local-token

# CodingMemory embedding provider (DashScope native synchronous API)
DMSA_PROFILE=sparse-dev
DMSA_RSI_ENABLED=true
DMSA_RSI_MODELS=true
DMSA_EMBEDDING_BASE_URL=https://your-dashscope-native-embedding-endpoint
DMSA_EMBEDDING_API_KEY=
DMSA_EMBEDDING_MODEL=qwen3.7-text-embedding
DMSA_EMBEDDING_DIMENSION=1024

# Offline RSI constrained advisor; the replay gate remains authoritative.
DMSA_DECISION_BASE_URL=https://your-decision-model-compatible-endpoint/v1
DMSA_DECISION_API_KEY=
DMSA_DECISION_MODEL=decision-model-preview

# Text generation / legacy SGA feedback fusion provider.
DMSA_TEXT_BASE_URL=https://api.minimax.cn/v1
DMSA_TEXT_API_KEY=
DMSA_TEXT_MODEL=MiniMax-M3.1-Flash

# Existing DMSA gradient fusion config: used by the optional stdio MCP profile.
DMSA_GRADIENT__FUSION_BACKEND=llm
DMSA_GRADIENT__LLM_CHAT_MODEL=MiniMax-M3.1-Flash
DMSA_GRADIENT__LLM_BASE_URL=https://api.minimax.cn/v1
DMSA_GRADIENT__LLM_API_KEY_ENV=DMSA_TEXT_API_KEY
